<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0915"
    tools:context=".MainActivity">

    <View
        android:id="@+id/ambient_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_ambient_gradient" />

    <LinearLayout
        android:id="@+id/top_hud_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:background="@drawable/glass_panel"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ NOVA OS"
            android:textColor="#00F0FF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:shadowColor="#00F0FF"
            android:shadowRadius="10"/>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

        <TextView
            android:id="@+id/tv_network_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌐 0.8 KB/s"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginEnd="16dp"/>

        <TextView
            android:id="@+id/tv_vpn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️ VPN: OFF"
            android:textColor="#00FF66"
            android:textSize="14sp"
            android:layout_marginEnd="16dp"/>

        <TextView
            android:id="@+id/tv_ram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧠 RAM: 42%"
            android:textColor="#FF3366"
            android:textSize="14sp"
            android:layout_marginEnd="12dp"/>

        <Button
            android:id="@+id/btn_boost"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="⚡ BOOST"
            android:textSize="11sp"
            android:background="@drawable/btn_neon_pink"
            android:textColor="#FFFFFF"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tv_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="09:04 AM"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginStart="24dp"/>
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/hero_showcase"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_margin="24dp"
        android:padding="20dp"
        android:background="@drawable/glass_panel_heavy"
        app:layout_constraintTop_toBottomOf="@id/top_hud_bar">

        <ImageView
            android:id="@+id/hero_app_icon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@android:drawable/sym_def_app_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/hero_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WELCOME TO NOVA TV"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="26sp"
            android:layout_marginStart="20dp"
            app:layout_constraintTop_toTopOf="@id/hero_app_icon"
            app:layout_constraintStart_toEndOf="@id/hero_app_icon" />

        <TextView
            android:id="@+id/hero_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Future Edition Launcher for Amazon Fire TV Stick"
            android:textColor="#B0B5D0"
            android:textSize="14sp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/hero_title"
            app:layout_constraintStart_toEndOf="@id/hero_app_icon" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginStart="20dp"
            app:layout_constraintTop_toBottomOf="@id/hero_subtitle"
            app:layout_constraintStart_toEndOf="@id/hero_app_icon">

            <Button
                android:id="@+id/btn_launch"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="▶ LAUNCH"
                android:background="@drawable/btn_neon_blue"
                android:textColor="#00F0FF"
                android:focusable="true"/>

            <Button
                android:id="@+id/btn_themes"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🎨 THEME: CYBERPUNK"
                android:layout_marginStart="12dp"
                android:background="@drawable/btn_neon_cyan"
                android:textColor="#E0E0E0"
                android:focusable="true"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_apps"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginHorizontal="24dp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingVertical="10dp"
        app:layout_constraintTop_toBottomOf="@id/hero_showcase" />

    <LinearLayout
        android:id="@+id/bottom_dock"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/glass_dock"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FLOATING GLASS DOCK • ⚙️ SETTINGS • 📂 ALL APPS"
            android:textColor="#85FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
